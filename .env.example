# Copy to .env for local runs only. Bedrock AgentCore Runtime deployments
# set these as environment variables on the agent runtime resource instead
# (see README.md) - never bake real credentials into the image.

# Foundation model (defaults to Amazon Nova Pro - see config.py for rationale)
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
AWS_REGION=us-east-1
BEDROCK_MODEL_TEMPERATURE=0.2
BEDROCK_MODEL_MAX_TOKENS=4096

# Set to false if your runtime image doesn't have terraform/checkov installed.
ENABLE_TERRAFORM_VALIDATION=true

# Required label for aws-iac-mcp-server; ignored when running under an IAM
# role (e.g. inside AgentCore Runtime).
AWS_PROFILE=default

# Local-only credentials (do NOT set these in the deployed runtime - use the
# execution IAM role instead):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
